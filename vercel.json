{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/now/backend", "status": 404 },
    { "src": "/now/backend/(.*)", "status": 404 },
    { "src": "/", "dest": "/now/index.html" },
    { "src": "/index.html", "dest": "/now/index.html" },
    { "src": "/index-integrated.html", "dest": "/now/index-integrated.html" },
    { "src": "/e2e-(.*)", "dest": "/now/e2e-$1" },
    { "handle": "filesystem" }
  ]
}
